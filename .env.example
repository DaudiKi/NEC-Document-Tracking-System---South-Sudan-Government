# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Never expose to the browser. Needed for creating users, scheduled jobs and file integrity checks.
SUPABASE_SERVICE_ROLE_KEY=

# Secret that protects /api/cron/* (Vercel Cron sends it as "Authorization: Bearer ...")
CRON_SECRET=

# Set to "true" only when the Supabase Auth hook "Password Verification Attempt" points at
# public.hook_password_verification_attempt (then the app does not count failed logins itself)
AUTH_HOOK_ENABLED=false

# Demo only: show the demo accounts on the login screen
NEXT_PUBLIC_DEMO_MODE=false
